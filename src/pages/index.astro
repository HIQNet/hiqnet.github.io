---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/navigation/Header.astro";
import Footer from "../components/navigation/Footer.astro";
import Hero from "../components/home/Hero.astro";
import Services from "../components/home/Services.astro";
import Approach from "../components/home/Approach.astro";
import Work from "../components/home/Work.astro";
import ContactCta from "../components/home/ContactCta.astro";
import { site } from "../config/site";
---

<BaseLayout title={site.title} description={site.description} canonicalPath="/">
  <Header />
  <main id="contenido">
    <Hero />
    <Approach />
    <Services />
    <Work />
    <ContactCta />
  </main>
  <Footer compact />
</BaseLayout>
