---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { site, whatsappUrl } from "../../data/site";
import { getProjectPresentation } from "../../data/projectPresentation";
import "../../styles/projects.css";

export async function getStaticPaths() {
    const projects = (await getCollection("projects")).sort(
        (a, b) => a.data.order - b.data.order,
    );
    return projects.map((project, index) => ({
        params: { slug: project.id },
        props: {
            project,
            previous: projects[index - 1] ?? null,
            next: projects[index + 1] ?? null,
        },
    }));
}

interface Props {
    project: CollectionEntry<"projects">;
    previous: CollectionEntry<"projects"> | null;
    next: CollectionEntry<"projects"> | null;
}

const { project, previous, next } = Astro.props;
const data = project.data;
const presentation = getProjectPresentation(project.id);
const reference =
    data.client.trim() === "-" ? "Sin cliente identificado" : data.client;
---

<BaseLayout
    title={`${presentation.name} | HiQNet`}
    description={presentation.summary}
    canonicalPath={`/proyectos/${project.id}.html`}
    image={presentation.image.src}
>
    <Navbar />
    <main id="contenido" class="project-detail">
        <header class="project-detail__hero container-page">
            <a href="/index.html#proyectos" class="text-link project-link">
                <span aria-hidden="true">←</span>Todos los proyectos
            </a>
            <div class="project-detail__intro">
                <p class="eyebrow">
                    {presentation.sector} / {presentation.name}
                </p>
                <h1>{presentation.title}</h1>
                <p class="section-copy">{presentation.summary}</p>
            </div>
            <figure class="project-detail__cover">
                <img
                    src={presentation.image.src}
                    width={presentation.image.width}
                    height={presentation.image.height}
                    alt={presentation.image.alt}
                    fetchpriority="high"
                    decoding="async"
                />
                <figcaption>{presentation.image.caption}</figcaption>
            </figure>
        </header>

        <div class="container-page project-detail__layout section-space">
            <div class="project-narrative">
                <section
                    class="project-chapter"
                    aria-labelledby="contexto-title"
                >
                    <p class="project-chapter__number" aria-hidden="true">
                        01 / Contexto
                    </p>
                    <h2 id="contexto-title">La forma de trabajar.</h2>
                    <p>{presentation.context}</p>
                </section>
                <section
                    class="project-chapter"
                    aria-labelledby="problema-title"
                >
                    <p class="project-chapter__number" aria-hidden="true">
                        02 / Problema
                    </p>
                    <h2 id="problema-title">El punto de partida.</h2>
                    <p>{presentation.problem}</p>
                </section>
                <section
                    class="project-chapter"
                    aria-labelledby="intervencion-title"
                >
                    <p class="project-chapter__number" aria-hidden="true">
                        03 / Intervención
                    </p>
                    <h2 id="intervencion-title">Qué se trabajó.</h2>
                    <p>{presentation.intervention}</p>
                </section>
                <section
                    class="project-chapter"
                    aria-labelledby="sistema-title"
                >
                    <p class="project-chapter__number" aria-hidden="true">
                        04 / Sistema
                    </p>
                    <h2 id="sistema-title">Cómo se relacionan las piezas.</h2>
                    <p>{presentation.system}</p>
                    <ol
                        class="project-system"
                        aria-label="Secuencia del sistema descrito"
                    >
                        {presentation.flow.map((step, index) => (
                            <li>
                                <span
                                    class="project-system__number"
                                    aria-hidden="true"
                                >
                                    0{index + 1}
                                </span>
                                <span>{step}</span>
                            </li>
                        ))}
                    </ol>
                </section>
            </div>
            <aside class="project-facts" aria-labelledby="ficha-title">
                <h2 id="ficha-title" class="eyebrow">
                    Ficha del proyecto
                </h2>
                <dl>
                    <div>
                        <dt>Sector</dt>
                        <dd>{presentation.sector}</dd>
                    </div>
                    <div>
                        <dt>Referencia del proyecto</dt>
                        <dd>{reference}</dd>
                    </div>
                    <div>
                        <dt>Duración declarada</dt>
                        <dd>{data.duration}</dd>
                    </div>
                    <div>
                        <dt>Estado declarado</dt>
                        <dd>{data.status}</dd>
                    </div>
                    <div>
                        <dt>Tecnologías</dt>
                        <dd>{data.tech.join(" / ")}</dd>
                    </div>
                </dl>
                <div class="project-facts__scope">
                    <h3>Alcance del caso</h3>
                    <p>{presentation.scope}</p>
                </div>
                {data.links.length > 0 && (
                    <div class="project-facts__resources">
                        <h3>Recursos del proyecto</h3>
                        <ul>
                            {data.links.map((link) => (
                                <li>
                                    <a
                                        class="text-link project-link"
                                        href={link.href}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        {link.label}
                                        <span aria-hidden="true">↗</span>
                                        <span class="project-visually-hidden">
                                            {" "}
                                            (se abre en otra pestaña)
                                        </span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                )}
            </aside>
        </div>

        {presentation.gallery.length > 0 && (
            <section
                class="project-gallery section-space"
                aria-labelledby="galeria-title"
            >
                <div class="container-page">
                    <header class="section-heading projects-heading">
                        <div>
                            <p class="eyebrow">Archivo visual</p>
                            <h2 id="galeria-title" class="section-title">
                                El proyecto en pantalla.
                            </h2>
                        </div>
                        <p class="section-copy">
                            Un recorrido por las interfaces y las tareas que
                            resuelve cada pantalla.
                        </p>
                    </header>
                    <div class="project-gallery__list">
                        {presentation.gallery.map((image, index) => (
                            <figure class="project-gallery__item">
                                <a
                                    href={image.src}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    aria-label={`Abrir imagen a tamaño completo: ${image.alt} (otra pestaña)`}
                                >
                                    <img
                                        src={image.src}
                                        width={image.width}
                                        height={image.height}
                                        loading="lazy"
                                        decoding="async"
                                        alt={image.alt}
                                    />
                                </a>
                                <figcaption>
                                    <span
                                        class="project-gallery__number"
                                        aria-hidden="true"
                                    >
                                        {String(index + 1).padStart(2, "0")}
                                    </span>
                                    <span>{image.caption}</span>
                                    <span aria-hidden="true">↗</span>
                                </figcaption>
                            </figure>
                        ))}
                    </div>
                </div>
            </section>
        )}

        <section
            class="project-contact section-space"
            aria-labelledby="project-contact-title"
        >
            <div class="container-page project-contact__layout">
                <div>
                    <p class="eyebrow">Hablemos de tu operación</p>
                    <h2 id="project-contact-title" class="section-title">
                        ¿Qué proceso necesitas ordenar?
                    </h2>
                    <p class="section-copy">
                        Cuéntanos cómo trabaja tu equipo, qué información
                        necesita y dónde se detiene el proceso. Ese es el punto
                        de partida.
                    </p>
                </div>
                <div class="project-contact__actions">
                    <a
                        href={whatsappUrl(
                            `Hola, vi el proyecto ${presentation.name} y quiero conversar sobre un proceso de mi empresa.`,
                        )}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="button-primary"
                        data-event="click_project_cta"
                    >
                        Conversar por WhatsApp <span aria-hidden="true">↗</span>
                    </a>
                    <a
                        href={`mailto:${site.email}`}
                        class="text-link project-link"
                        data-event="click_email"
                    >
                        {site.email}
                        <span aria-hidden="true">↗</span>
                    </a>
                </div>
            </div>
        </section>

        <nav
            class="container-page project-pagination"
            aria-label="Navegación entre proyectos"
        >
            {previous && (
                <a
                    class="project-pagination__link"
                    href={`/proyectos/${previous.id}.html`}
                    rel="prev"
                >
                    <span class="project-kicker">← Proyecto anterior</span>
                    <strong>{getProjectPresentation(previous.id).name}</strong>
                </a>
            )}
            {next && (
                <a
                    class="project-pagination__link project-pagination__link--next"
                    href={`/proyectos/${next.id}.html`}
                    rel="next"
                >
                    <span class="project-kicker">Proyecto siguiente →</span>
                    <strong>{getProjectPresentation(next.id).name}</strong>
                </a>
            )}
        </nav>
    </main>
    <Footer />
    <script src="../../scripts/index.ts"></script>
</BaseLayout>
