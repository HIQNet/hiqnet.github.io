---
import { whatsappUrl } from "../data/site";
import WhatsAppIcon from "./common/WhatsAppIcon.astro";
import Icon from "./common/Icon.astro";
---

<a
    class="persistent-cta"
    href={whatsappUrl()}
    target="_blank"
    rel="noopener noreferrer"
    data-event="click_whatsapp_floating"
    data-persistent-cta
    hidden
    aria-label="Hablemos por WhatsApp"
>
    <WhatsAppIcon size={20} />
    <span>Hablemos</span>
    <Icon name="arrow-up-right" size={14} class="ui-icon" />
</a>
