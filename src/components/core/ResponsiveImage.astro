---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Passed to the generated `sizes` attribute for the responsive srcset. */
  sizes?: string;
  widths?: number[];
  /** Above-the-fold images load eagerly with high priority. */
  priority?: boolean;
  class?: string;
}

const {
  src,
  alt,
  sizes = "(min-width: 80rem) 1248px, (min-width: 64rem) 64rem, 100vw",
  widths,
  priority = false,
  class: className,
} = Astro.props;
---

<Image
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  class={className}
  loading={priority ? "eager" : "lazy"}
  decoding={priority ? "sync" : "async"}
  fetchpriority={priority ? "high" : "auto"}
/>
