---
import { site } from "../data/site";
---

<section id="contact" class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="text-center mb-12">
    <h2 class="text-3xl md:text-4xl font-bold mb-4">
      <span class="gradient-text">Contáctanos</span>
    </h2>
    <p class="text-lg text-slate-400 max-w-2xl mx-auto">
      ¿Listo para comenzar tu proyecto? Escríbenos directo y te respondemos en
      menos de 24 horas.
    </p>
  </div>

  <div class="grid gap-6 sm:grid-cols-2 max-w-3xl mx-auto mb-12">
    <a
      href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent("Hola HiQNet, quiero información sobre un proyecto.")}`}
      target="_blank"
      rel="noopener noreferrer"
      class="glass rounded-2xl p-6 flex items-center gap-4 transition-all duration-300 hover:scale-[1.02] hover:border-green-400/40"
    >
      <div class="w-12 h-12 bg-green-600 rounded-full flex items-center justify-center text-white flex-shrink-0">
        <i class="fab fa-whatsapp text-xl"></i>
      </div>
      <div class="text-left">
        <h3 class="font-bold text-lg text-white mb-1">WhatsApp</h3>
        <p class="text-sm text-slate-400">Respuesta más rápida</p>
      </div>
    </a>

    <a
      href={`mailto:${site.email}`}
      class="glass rounded-2xl p-6 flex items-center gap-4 transition-all duration-300 hover:scale-[1.02] hover:border-cyan-400/40"
    >
      <div class="w-12 h-12 gradient-bg rounded-full flex items-center justify-center text-white flex-shrink-0">
        <i class="fas fa-envelope"></i>
      </div>
      <div class="text-left">
        <h3 class="font-bold text-lg text-white mb-1">Correo</h3>
        <p class="text-sm text-slate-400 break-all">{site.email}</p>
      </div>
    </a>
  </div>

  <div class="flex justify-center gap-4">
    <a
      href={site.socials.facebook}
      aria-label="Facebook"
      class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center text-purple-400 hover:bg-purple-900/50 transition-colors"
    >
      <i class="fab fa-facebook-f"></i>
    </a>
    <a
      href={site.socials.instagram}
      aria-label="Instagram"
      class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center text-purple-400 hover:bg-purple-900/50 transition-colors"
    >
      <i class="fab fa-instagram"></i>
    </a>
  </div>
</section>
