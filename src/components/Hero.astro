---
import type { ProjectType } from "../data/questionnaire";

interface BuildPath {
  type: ProjectType;
  icon: string;
  title: string;
  description: string;
}

const buildPaths: BuildPath[] = [
  {
    type: "web",
    icon: "fas fa-globe",
    title: "Sitio Web",
    description: "Presencia digital que vende por ti.",
  },
  {
    type: "sistema",
    icon: "fas fa-laptop-code",
    title: "Sistema Empresarial",
    description: "Opera y controla tu negocio en línea.",
  },
  {
    type: "automatizacion",
    icon: "fas fa-code-branch",
    title: "Automatización / API",
    description: "Conecta sistemas, elimina trabajo manual.",
  },
];
---

<section id="home" class="pt-28 pb-20 md:pt-36 md:pb-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="flex flex-col md:flex-row items-center gap-12">
    <div class="md:w-1/2">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
        ¿Qué quieres <span class="gradient-text">construir?</span>
      </h1>
      <p class="text-lg md:text-xl text-slate-300 mb-10 max-w-xl">
        Cuéntanos tu idea y te damos un plan claro con tiempos y presupuesto.
        Sin compromiso, sin sorpresas.
      </p>

      <div class="grid gap-4 sm:grid-cols-3">
        {
          buildPaths.map((path) => (
            <button
              type="button"
              data-quote-open
              data-project-type={path.type}
              class="glass rounded-2xl p-5 text-left transition-all duration-300 hover:scale-[1.03] hover:border-cyan-400/40 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400 cursor-pointer group"
            >
              <div class="w-11 h-11 gradient-bg rounded-xl flex items-center justify-center mb-3 shadow-lg">
                <i class={`${path.icon} text-white text-lg`} />
              </div>
              <span class="block font-semibold text-white mb-1">{path.title}</span>
              <span class="block text-sm text-slate-400">{path.description}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="md:w-1/2 flex justify-center">
      <img id="logoAnimate" src="/Animated LogoV2.gif" alt="Logo animado de HiQNet" class="w-80 lg:w-96 mx-auto" />
    </div>
  </div>
</section>
