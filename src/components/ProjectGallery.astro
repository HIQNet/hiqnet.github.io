---
interface GalleryImage {
  src: string;
  alt: string;
  caption: string;
}

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
---

<div class="border-t border-gray-700 px-8 py-6 bg-gray-900">
  <h3 class="text-2xl font-semibold text-gray-200 mb-6">Galería del Proyecto</h3>
  <div class="project-gallery grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {
      images.map((image) => (
        <div
          class="gallery-item rounded-lg overflow-hidden cursor-pointer shadow-lg hover:shadow-indigo-500/50 transition"
          onclick={`openImageModal('${image.src}')`}
        >
          <img src={image.src} alt={image.alt} class="w-full h-48 object-cover" />
          <div class="bg-gray-800 p-3">
            <p class="text-sm font-medium text-gray-200">{image.caption}</p>
          </div>
        </div>
      ))
    }
  </div>
</div>
