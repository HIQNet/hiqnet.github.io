---
import Button from "../core/Button.astro";
import TextLink from "../core/TextLink.astro";
import ResponsiveImage from "../core/ResponsiveImage.astro";
import WhatsAppIcon from "../ui/WhatsAppIcon.astro";
import { whatsappUrl } from "../../config/contact";
import proofImage from "../../assets/cases/la-terraza/admin-04.png";
---

<section id="inicio" class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="hero__label">Software y sistemas para empresas</p>

      <h1 id="hero-title" class="type-display hero__title">
        Software que hace más claro el trabajo.
      </h1>

      <p class="type-lead hero__copy">
        Plataformas web, sistemas internos e integraciones, hechos a la medida de tu empresa.
        Herramientas que se entienden desde el primer día.
      </p>

      <div class="hero__actions">
        <Button href={whatsappUrl()} external icon="arrow-up-right">
          <WhatsAppIcon size={17} />
          Hablemos por WhatsApp
        </Button>
        <TextLink href="#casos">Ver casos reales</TextLink>
      </div>
    </div>

    <figure class="hero__proof">
      <ResponsiveImage
        src={proofImage}
        alt="Pantalla administrativa de productos de La Terraza, desarrollada por HiQNet"
        priority
        widths={[720, 1100, 1600]}
        sizes="(min-width: 64rem) 60vw, 100vw"
      />
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    border-bottom: var(--border-width) solid var(--color-line);
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 3vw, 3rem);
    min-height: 33rem;
    align-items: center;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    width: min(100%, 35rem);
    padding-block: 3rem;
  }

  .hero__label {
    font-family: var(--font-display);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--text-label--letter-spacing);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero__title {
    max-width: 14ch;
    margin-top: 1.3rem;
    font-size: clamp(3.3rem, 4.6vw, 4.8rem);
    line-height: 1.01;
    letter-spacing: -0.05em;
  }

  .hero__copy {
    max-width: 32rem;
    margin-top: 1.6rem;
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.75rem;
  }

  .hero__proof {
    min-width: 0;
    overflow: hidden;
    border: var(--border-width) solid var(--color-line-strong);
    background: var(--color-surface);
    aspect-ratio: 1.55;
  }

  .hero__proof :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
  }

  @media (max-width: 63.99rem) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: 0;
      min-height: 0;
    }

    .hero__content {
      padding-block: 3.5rem 2rem;
    }

    .hero__proof {
      margin-bottom: 2rem;
    }
  }

  @media (max-width: 47.99rem) {
    .hero__content {
      padding-block: 2.8rem 1.6rem;
    }

    .hero__title {
      font-size: clamp(2.65rem, 10.4vw, 4.2rem);
    }

    .hero__copy {
      margin-top: 1.25rem;
    }

    .hero__actions {
      gap: 0.75rem 1.25rem;
      margin-top: 1.5rem;
    }

    .hero__proof {
      aspect-ratio: 1.45;
    }
  }
</style>
