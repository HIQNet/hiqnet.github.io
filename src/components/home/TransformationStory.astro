---
import OperationDiagram from "../common/OperationDiagram.astro";
import { transformation } from "../../data/narrative";
---

<section
    class="story-section"
    data-story-section
    aria-labelledby="transformacion-title"
>
    <div class="container-page">
        <h2 id="transformacion-title" class="sr-only">
            De piezas aisladas a una operación conectada
        </h2>
        <div class="story-layout">
            <div class="story-visual" data-story-visual aria-hidden="true">
                <div class="diagram-heading">
                    <span>Mapa de operación / Esquema conceptual</span>
                    <span data-story-caption>Un sistema conectado</span>
                </div>
                <OperationDiagram />
                <div class="diagram-legend">
                    <span>
                        <i></i>Conexión
                    </span>
                    <span>
                        <i></i>Automatización
                    </span>
                    <span>
                        <i></i>Sistema
                    </span>
                </div>
            </div>
            <ol class="story-steps" data-story-steps>
                {transformation.map((stage, index) => (
                    <li class="story-step" data-story-step={index + 1}>
                        <p class="eyebrow">
                            <span>{stage.number} /</span>
                            {stage.label}
                        </p>
                        <h3>{stage.title}</h3>
                        <p class="section-copy">{stage.copy}</p>
                        <div
                            class="story-mobile-diagram"
                            style={stage.diagram}
                            aria-hidden="true"
                        >
                            <OperationDiagram />
                        </div>
                    </li>
                ))}
            </ol>
        </div>
    </div>
</section>
