---
const stages = [
    {
        number: "01",
        label: "Procesos que funcionan por separado",
        title: "Cada parte exige seguimiento propio",
        copy: "Cuando cada parte trabaja por su cuenta, el seguimiento depende de tareas manuales y de información dispersa.",
    },
    {
        number: "02",
        label: "Hacemos que las piezas se comuniquen",
        title: "Las piezas empiezan a comunicarse",
        copy: "Conectamos herramientas, información y procesos para que tu equipo trabaje sobre el mismo contexto.",
    },
    {
        number: "03",
        label: "El trabajo empieza a fluir",
        title: "Menos pasos repetitivos para el equipo",
        copy: "Reducimos pasos repetitivos y hacemos que la información llegue donde realmente se necesita.",
    },
    {
        number: "04",
        label: "Todo funciona como un sistema",
        title: "Software alineado con tu forma de operar",
        copy: "Construimos software alrededor de la forma real en que trabaja tu empresa.",
    },
] as const;
---

<section
    class="story-section border-y border-line bg-surface/45 py-24 sm:py-32"
    data-story-section
    aria-labelledby="transformacion-title"
>
    <div class="container-page">
        <div class="editorial-reveal max-w-3xl">
            <p class="eyebrow">Una operación conectada</p>
            <h2 id="transformacion-title" class="section-title mt-4">
                De piezas aisladas a una operación que trabaja en conjunto.
            </h2>
            <p class="section-copy mt-5">
                Una empresa no necesita acumular más herramientas. Necesita que
                las piezas importantes de su operación se entiendan y avancen
                como un solo sistema.
            </p>
        </div>

        <div class="story-layout mt-14 lg:grid lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:gap-20">
            <div
                class="story-visual lg:sticky lg:top-28 lg:self-start"
                data-story-visual
                data-motion="story"
                data-story-stage="1"
                aria-hidden="true"
            >
                <svg
                    class="story-map"
                    viewBox="0 0 600 480"
                    fill="none"
                    preserveAspectRatio="xMidYMid meet"
                >
                    <g class="story-map__system-boundary">
                        <path
                            pathLength="1"
                            d="M153 104C226 45 374 45 447 104"
                        />
                        <path
                            pathLength="1"
                            d="M481 145C529 208 525 302 481 353"
                        />
                        <path
                            pathLength="1"
                            d="M447 380C374 437 226 437 153 380"
                        />
                        <path
                            pathLength="1"
                            d="M119 353C72 296 74 208 119 145"
                        />
                    </g>

                    <g class="story-map__connections story-map__connections--routes">
                        <path
                            pathLength="1"
                            d="M172 123C208 126 221 162 241 187"
                        />
                        <path
                            pathLength="1"
                            d="M154 281C192 273 212 257 234 246"
                        />
                        <path
                            pathLength="1"
                            d="M428 123C392 126 379 162 359 187"
                        />
                        <path
                            pathLength="1"
                            d="M446 281C409 273 389 257 366 246"
                        />
                    </g>

                    <g class="story-map__automation-routes">
                        <path
                            pathLength="1"
                            d="M216 183C261 133 348 132 393 183"
                        />
                        <path
                            pathLength="1"
                            d="M397 282C351 331 254 331 204 280"
                        />
                    </g>

                    <g class="story-map__node story-map__source story-map__source--clients">
                        <rect x="72" y="104" width="100" height="38" rx="19" />
                        <text x="122" y="128">
                            CLIENTES
                        </text>
                    </g>
                    <g class="story-map__node story-map__source story-map__source--team">
                        <rect x="54" y="262" width="100" height="38" rx="19" />
                        <text x="104" y="286">
                            OPERACIÓN
                        </text>
                    </g>
                    <g class="story-map__node story-map__source story-map__source--data">
                        <rect x="428" y="104" width="100" height="38" rx="19" />
                        <text x="478" y="128">
                            INFORMACIÓN
                        </text>
                    </g>
                    <g class="story-map__node story-map__source story-map__source--services">
                        <rect x="446" y="262" width="90" height="38" rx="19" />
                        <text x="491" y="286">
                            SERVICIOS
                        </text>
                    </g>

                    <g class="story-map__node story-map__core">
                        <circle cx="300" cy="232" r="67" />
                        <circle
                            class="story-map__core-ring"
                            cx="300"
                            cy="232"
                            r="83"
                        />
                        <text x="300" y="228">
                            OPERACIÓN
                        </text>
                        <text class="story-map__subtext" x="300" y="246">
                            CONECTADA
                        </text>
                    </g>
                    <g class="story-map__automation-label">
                        <rect x="205" y="318" width="190" height="34" rx="17" />
                        <text x="300" y="340">
                            FLUJO DE TRABAJO
                        </text>
                    </g>
                    <g class="story-map__system-label">
                        <path d="M263 405h74" />
                        <text x="300" y="430">
                            SISTEMA
                        </text>
                    </g>
                </svg>
            </div>

            <ol class="story-steps mt-10 grid gap-0 lg:mt-0" data-story-steps>
                {stages.map((stage, index) => (
                    <li
                        class="story-step card-reveal"
                        data-story-step={String(index + 1)}
                    >
                        <p class="text-xs font-bold tracking-[0.14em] text-brand-cyan">
                            {stage.number} — {stage.label}
                        </p>
                        <h3 class="mt-3 text-2xl font-bold tracking-[-0.025em] text-white">
                            {stage.title}
                        </h3>
                        <p class="mt-3 max-w-xl text-base leading-7 text-muted">
                            {stage.copy}
                        </p>
                    </li>
                ))}
            </ol>
        </div>
    </div>
</section>
