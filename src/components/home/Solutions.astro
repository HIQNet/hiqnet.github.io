---
import WebInterfaceScene from "../scenes/WebInterfaceScene.astro";
import AutomationScene from "../scenes/AutomationScene.astro";
import BusinessSystemScene from "../scenes/BusinessSystemScene.astro";
---

<section
    id="soluciones"
    class="capabilities section-space"
    aria-labelledby="soluciones-title"
    data-capabilities
>
    <div class="container-page">
        <div class="section-heading reveal">
            <div>
                <p class="eyebrow">
                    <span>02 /</span> Qué podemos construir
                </p>
                <h2 id="soluciones-title" class="section-title">
                    Cada operación pide una estructura.
                </h2>
            </div>
            <p class="section-copy">
                A veces hace falta una interfaz. A veces, conectar lo que ya
                existe. Otras, construir un sistema propio. La solución depende
                del proceso, no de una plantilla.
            </p>
        </div>
    </div>
    <div class="cap-pinned" data-cap-pinned>
        <div class="cap-track" data-cap-track>
            <article
                id="hiqnet-web"
                class="capability capability-web"
                data-cap-panel
            >
                <div class="capability-copy">
                    <p class="capability-name">HiQNet Web</p>
                    <h3>
                        La interfaz de
                        <br />
                        tu negocio.
                    </h3>
                    <p class="section-copy">
                        Sitios y plataformas web que organizan lo que ofreces y
                        lo que tus usuarios necesitan hacer. Desde consultar un
                        catálogo hasta trabajar dentro de una aplicación.
                    </p>
                    <p class="capability-meta">
                        Sitios empresariales / Catálogos / Plataformas web
                    </p>
                </div>
                <div class="capability-visual reveal" aria-hidden="true">
                    <WebInterfaceScene />
                </div>
            </article>
            <article
                id="hiqnet-automate"
                class="capability capability-automate"
                data-cap-panel
            >
                <div class="capability-copy">
                    <p class="capability-name">HiQNet Automate</p>
                    <h3>
                        Menos copiar.
                        <br />
                        Más conectar.
                    </h3>
                    <p class="section-copy">
                        Integramos herramientas y APIs para que un dato no tenga
                        que capturarse en cada sistema. Definimos reglas,
                        sincronización y flujos alrededor de las tareas
                        repetitivas.
                    </p>
                    <p class="capability-meta">
                        APIs / Integraciones / Sincronización / Flujos
                    </p>
                </div>
                <div class="capability-visual reveal" aria-hidden="true">
                    <AutomationScene />
                </div>
            </article>
            <article
                id="hiqnet-business"
                class="capability capability-business"
                data-cap-panel
            >
                <div class="capability-copy">
                    <p class="capability-name">HiQNet Business</p>
                    <h3>
                        Tu proceso.
                        <br />
                        Tu sistema.
                    </h3>
                    <p class="section-copy">
                        Software interno para gestionar información,
                        responsabilidades y seguimiento. Módulos que comparten
                        datos, construidos para las reglas de tu organización.
                    </p>
                    <p class="capability-meta">
                        Sistemas internos / Administración / Software a medida
                    </p>
                </div>
                <div class="capability-visual reveal" aria-hidden="true">
                    <BusinessSystemScene />
                </div>
            </article>
        </div>
        <p class="cap-indicator" data-cap-indicator>
            <span class="cap-indicator__label">Recorrido</span>
            <span class="cap-indicator__track" aria-hidden="true">
                <i></i>
                <i></i>
                <i></i>
            </span>
            <span class="cap-indicator__sep" aria-hidden="true">
                /
            </span>
            <span class="cap-indicator__total">03</span>
        </p>
    </div>
</section>
