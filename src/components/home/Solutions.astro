---
import { whatsappUrl } from "../../data/site";
const solutions = [
    {
        name: "HiQNet Web",
        problem:
            "Tu sitio existe, pero no está ayudando a generar oportunidades.",
        solution:
            "Diseñamos presencia digital clara, rápida y orientada a conversión.",
        benefit: "Convierte visitas en conversaciones comerciales.",
        examples:
            "Sitios empresariales · landing pages · catálogos · e-commerce",
    },
    {
        name: "HiQNet Automate",
        problem:
            "Tu equipo repite tareas y mueve información entre herramientas.",
        solution:
            "Conectamos sistemas, APIs y flujos para que la operación avance sin pasos innecesarios.",
        benefit: "Reduce trabajo manual y evita información duplicada.",
        examples: "Integraciones · reportes · sincronización · flujos internos",
    },
    {
        name: "HiQNet Business",
        problem:
            "Excel ya no alcanza para controlar una operación que está creciendo.",
        solution:
            "Construimos software a la medida de la forma en que trabaja tu empresa.",
        benefit:
            "Ten control de procesos, datos y seguimiento en un solo lugar.",
        examples: "Inventarios · POS · CRM · dashboards · plataformas internas",
    },
];
---

<section id="soluciones" class="py-20 sm:py-28">
    <div class="container-page">
        <div class="editorial-reveal grid gap-6 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
            <div>
                <p class="eyebrow">Soluciones</p>
                <h2 class="section-title mt-4">
                    Tecnología aplicada al problema correcto.
                </h2>
            </div>
            <p class="section-copy">
                No empezamos por el framework. Empezamos por entender dónde se
                detiene tu operación y qué debe cambiar para que tu equipo
                trabaje con mayor claridad.
            </p>
        </div>
        <div class="mt-12 grid gap-5 lg:grid-cols-3">
            {solutions.map((item, index) => (
                <article
                    class="solution-card card-reveal panel flex flex-col p-6"
                    data-delay={String(index + 1)}
                >
                    <svg
                        class="solution-orbit"
                        viewBox="0 0 72 56"
                        fill="none"
                        aria-hidden="true"
                    >
                        <path d="M8 40C22 10 49 7 64 26" />
                        <path d="M17 47C34 54 55 45 65 29" />
                        <circle cx="39" cy="29" r="7" />
                        <circle cx="8" cy="40" r="2" />
                        <circle cx="65" cy="29" r="2" />
                    </svg>
                    <p class="text-xs font-bold tracking-wider text-brand-cyan">
                        0{index + 1}
                    </p>
                    <h3 class="mt-5 text-2xl font-bold text-white">
                        {item.name}
                    </h3>
                    <div class="mt-6 space-y-5 text-sm leading-6">
                        <div>
                            <p class="font-semibold text-white">Problema</p>
                            <p class="mt-1 text-muted">{item.problem}</p>
                        </div>
                        <div>
                            <p class="font-semibold text-white">Qué hacemos</p>
                            <p class="mt-1 text-muted">{item.solution}</p>
                        </div>
                        <div class="border-l-2 border-brand-violet pl-3">
                            <p class="font-semibold text-white">Resultado</p>
                            <p class="mt-1 text-muted">{item.benefit}</p>
                        </div>
                    </div>
                    <p class="mt-6 text-xs leading-5 text-muted">
                        {item.examples}
                    </p>
                    <a
                        class="mt-6 text-sm font-bold text-brand-cyan hover:text-white"
                        href={whatsappUrl(
                            `Hola, encontré HiQNet y quiero conocer más sobre ${item.name}.`,
                        )}
                        target="_blank"
                        rel="noopener noreferrer"
                        data-event="click_solution"
                    >
                        Hablemos de tu caso <span aria-hidden="true">→</span>
                    </a>
                </article>
            ))}
        </div>
    </div>
</section>
