---
import { getCollection } from "astro:content";
const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order,
);
---

<section
    id="proyectos"
    class="border-y border-line bg-surface/45 py-20 sm:py-28"
>
    <div class="container-page">
        <div class="reveal flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
            <div>
                <p class="eyebrow">Casos de éxito</p>
                <h2 class="section-title mt-4">
                    Proyectos reales, explicados desde la operación.
                </h2>
            </div>
            <p class="section-copy">
                Cada caso resume el contexto, la solución implementada y el
                proceso que se buscó mejorar. Las tecnologías son el respaldo,
                no el titular.
            </p>
        </div>
        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {projects.map((project, index) => (
                <article
                    class="project-card reveal overflow-hidden rounded-panel border border-line bg-ink"
                    data-delay={String((index % 3) + 1)}
                >
                    <div class="project-card__media">
                        <img
                            src={project.data.cover}
                            width="1600"
                            height="956"
                            loading="lazy"
                            decoding="async"
                            alt={`Captura del proyecto ${project.data.cardTitle}`}
                            class="aspect-[16/9] w-full object-cover"
                        />
                    </div>
                    <div class="p-6">
                        <p class="text-xs font-bold uppercase tracking-wider text-brand-cyan">
                            {project.data.client}
                        </p>
                        <h3 class="mt-3 text-xl font-bold text-white">
                            {project.data.cardTitle}
                        </h3>
                        <p class="mt-3 text-sm leading-6 text-muted">
                            {project.data.cardDescription}
                        </p>
                        <div class="mt-5 border-t border-line pt-4">
                            <p class="text-xs font-semibold uppercase tracking-wider text-muted">
                                Problema que atendimos
                            </p>
                            <p class="mt-2 text-sm leading-6 text-copy">
                                {project.data.challenges[0]}
                            </p>
                        </div>
                        <a
                            class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-brand-cyan hover:text-white"
                            href={`/proyectos/${project.id}.html`}
                            data-event="view_project"
                        >
                            Ver caso{" "}
                            <span class="button-arrow" aria-hidden="true">
                                →
                            </span>
                        </a>
                    </div>
                </article>
            ))}
        </div>
    </div>
</section>
