---
import { navLinks, whatsappUrl } from "../data/site";
import Icon from "./common/Icon.astro";
import MobileNav from "./MobileNav.tsx";

const isHome =
    Astro.url.pathname === "/" || Astro.url.pathname === "/index.html";
const homeHref = (href: string) => (isHome ? href : `/${href}`);
---

<header class="site-header" data-site-header>
    <nav
        class="site-header__inner container-page"
        aria-label="Navegación principal"
    >
        <a
            href={homeHref("#inicio")}
            class="brand-link"
            aria-label="HiQNet, ir al inicio"
        >
            <img
                src="/img/FullLogo.webp"
                alt="HiQNet"
                width="1850"
                height="550"
            />
        </a>
        <div class="desktop-nav">
            {navLinks.map((link) => (
                <a
                    class="nav-link"
                    href={homeHref(link.href)}
                    data-nav-link={link.href}
                >
                    {link.label}
                </a>
            ))}
        </div>
        <a
            class="button-secondary nav-cta desktop-cta"
            href={whatsappUrl()}
            target="_blank"
            rel="noopener noreferrer"
            data-event="click_cta_header"
        >
            Hablemos <Icon name="arrow-up-right" size={16} />
        </a>
        <MobileNav
            client:load
            links={navLinks.map((link) => ({
                href: homeHref(link.href),
                label: link.label,
            }))}
            whatsappHref={whatsappUrl()}
        />
    </nav>
    <noscript>
        <nav
            class="container-page no-script-nav"
            aria-label="Enlaces de navegación"
        >
            {navLinks.map((link) => (
                <a href={homeHref(link.href)}>{link.label}</a>
            ))}
        </nav>
    </noscript>
</header>
