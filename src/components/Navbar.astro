---
import { navLinks, whatsappUrl } from "../data/site";
const isHome =
    Astro.url.pathname === "/" || Astro.url.pathname.endsWith("/index.html");
const homeHref = (href: string) => (isHome ? href : `/index.html${href}`);
---

<header class="sticky top-0 z-50 border-b border-line/80 bg-ink/95 backdrop-blur">
    <nav
        class="container-page flex min-h-16 items-center justify-between gap-4"
        aria-label="Navegación principal"
    >
        <a
            href={homeHref("#inicio")}
            class="shrink-0"
            aria-label="HiQNet, ir al inicio"
        >
            <img
                src="/img/FullLogo.webp"
                alt="HiQNet"
                width="1850"
                height="550"
                class="h-8 w-auto"
            />
        </a>
        <div class="hidden items-center gap-1 lg:flex">
            {navLinks.map((link) => (
                <a
                    href={homeHref(link.href)}
                    class="rounded-md px-3 py-2 text-sm font-medium text-muted transition hover:text-white"
                >
                    {link.label}
                </a>
            ))}
        </div>
        <div class="hidden lg:block">
            <a
                class="button-primary"
                href={whatsappUrl()}
                data-event="click_cta_header"
                target="_blank"
                rel="noopener noreferrer"
            >
                Cuéntanos tu proyecto
            </a>
        </div>
        <button
            id="menu-toggle"
            class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-md border border-line text-copy lg:hidden"
            type="button"
            aria-expanded="false"
            aria-controls="mobile-menu"
        >
            <span class="sr-only">Abrir menú</span>
            <svg
                aria-hidden="true"
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
            >
                <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
        </button>
    </nav>
    <div
        id="mobile-menu"
        class="container-page border-t border-line py-3 lg:hidden"
        hidden
    >
        <div class="grid gap-1">
            {navLinks.map((link) => (
                <a
                    href={homeHref(link.href)}
                    class="rounded-md px-3 py-3 font-medium text-copy hover:bg-surface-raised"
                >
                    {link.label}
                </a>
            ))}
            <a
                class="button-primary mt-2"
                href={whatsappUrl()}
                data-event="click_cta_mobile"
                target="_blank"
                rel="noopener noreferrer"
            >
                Cuéntanos tu proyecto
            </a>
        </div>
    </div>
</header>
