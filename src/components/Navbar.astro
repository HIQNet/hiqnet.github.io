---
import { navLinks, whatsappUrl } from "../data/site";
const isHome =
    Astro.url.pathname === "/" || Astro.url.pathname === "/index.html";
const homeHref = (href: string) => (isHome ? href : `/${href}`);
---

<header class="site-header" data-site-header>
    <nav
        class="site-header__inner container-page"
        aria-label="Navegación principal"
    >
        <a
            href={homeHref("#inicio")}
            class="brand-link"
            aria-label="HiQNet, ir al inicio"
        >
            <img
                src="/img/FullLogo.webp"
                alt="HiQNet"
                width="1850"
                height="550"
            />
        </a>
        <div class="desktop-nav">
            {navLinks.map((link) => (
                <a
                    class="nav-link"
                    href={homeHref(link.href)}
                    data-nav-link={link.href}
                >
                    {link.label}
                </a>
            ))}
        </div>
        <a
            class="button-secondary nav-cta desktop-cta"
            href={whatsappUrl()}
            target="_blank"
            rel="noopener noreferrer"
            data-event="click_cta_header"
        >
            Hablemos{" "}
            <span class="button-arrow" aria-hidden="true">
                ↗
            </span>
        </a>
        <button
            id="menu-toggle"
            class="menu-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="mobile-menu"
            hidden
        >
            <span class="sr-only">Abrir menú</span>
            <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
            >
                <path d="M4 8h16" />
                <path d="M4 16h16" />
            </svg>
        </button>
    </nav>
    <nav
        id="mobile-menu"
        class="mobile-menu"
        hidden
        aria-label="Navegación móvil"
    >
        <div class="container-page">
            {navLinks.map((link) => (
                <a
                    class="nav-link"
                    href={homeHref(link.href)}
                    data-nav-link={link.href}
                >
                    {link.label}
                </a>
            ))}
            <a
                class="button-primary"
                href={whatsappUrl()}
                target="_blank"
                rel="noopener noreferrer"
                data-event="click_cta_mobile"
            >
                Hablemos <span aria-hidden="true">↗</span>
            </a>
        </div>
    </nav>
    <noscript>
        <nav
            class="container-page no-script-nav"
            aria-label="Enlaces de navegación"
        >
            {navLinks.map((link) => (
                <a href={homeHref(link.href)}>{link.label}</a>
            ))}
        </nav>
    </noscript>
</header>
