---
import { essenceCards } from "../data/home";
---

<section class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="text-center mb-16">
    <h2 class="text-4xl md:text-5xl font-extrabold mb-4 tracking-tight text-slate-900 dark:text-white">
      Nuestra <span class="gradient-text">Esencia</span>
    </h2>
    <p class="text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">
      Descubre lo que nos mueve y define.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
    {
      essenceCards.map((card, index) => (
        <div
          class:list={[
            "bg-white dark:bg-slate-800 p-6 sm:p-8 rounded-2xl shadow-md hover:shadow-xl transition-all duration-300",
            // Literales para que el escáner de Tailwind las detecte
            ["order-1", "order-2", "order-3"][index],
            "sm:order-none",
            card.values ? "sm:col-span-2 lg:col-span-1 mx-auto w-full" : "",
          ]}
        >
          <div class="w-14 h-14 sm:w-16 sm:h-16 gradient-bg rounded-full flex items-center justify-center mb-5 mx-auto">
            <i class={`${card.icon} text-white text-xl sm:text-2xl`} />
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-center mb-3 text-slate-900 dark:text-white">
            {card.title}
          </h3>

          {card.paragraphs && (
            <div class="space-y-3">
              {card.paragraphs.map((paragraph) => (
                <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base text-justify leading-relaxed">
                  {paragraph}
                </p>
              ))}
            </div>
          )}

          {card.values && (
            <ul class="space-y-4 text-slate-600 dark:text-slate-300 text-sm sm:text-base text-justify">
              {card.values.map((value) => (
                <li class="flex items-start gap-2">
                  <i class="fas fa-check text-green-500 mt-1" />
                  <span>
                    <strong>{value.term}:</strong> {value.description}
                  </span>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))
    }
  </div>
</section>
