---
import { processSteps } from "../data/home";
---

<section id="process" class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="text-center mb-16">
    <h2 class="text-3xl md:text-4xl font-bold mb-4">
      Cómo <span class="gradient-text">trabajamos</span>
    </h2>
    <p class="text-lg text-slate-400 max-w-2xl mx-auto">
      Un proceso claro en cuatro pasos, con entregas visibles desde el inicio.
    </p>
  </div>

  <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {
      processSteps.map((step) => (
        <li class="glass rounded-2xl p-6 relative overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:border-cyan-400/30">
          <span class="absolute top-4 right-5 text-5xl font-bold text-slate-700/50 select-none" aria-hidden="true">
            {step.number}
          </span>
          <div class="w-12 h-12 gradient-bg rounded-xl flex items-center justify-center mb-4 shadow-lg">
            <i class={`${step.icon} text-white text-lg`} />
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">{step.title}</h3>
          <p class="text-sm text-slate-400 leading-relaxed">{step.description}</p>
        </li>
      ))
    }
  </ol>
</section>
