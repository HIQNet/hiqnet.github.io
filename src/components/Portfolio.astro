---
import { getCollection } from "astro:content";
import ProjectCard from "./ProjectCard.astro";
import { externalProjects } from "../data/externalProjects";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<section id="portfolio" class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="text-center mb-16">
    <h2 class="text-3xl md:text-4xl font-bold mb-4">
      Nuestro <span class="gradient-text">Portafolio</span>
    </h2>
    <p class="text-lg text-slate-600 dark:text-slate-300 max-w-3xl mx-auto">
      Algunos de los proyectos que hemos desarrollado para nuestros clientes en
      diversos sectores.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {
      projects.map((project) => (
        <ProjectCard
          title={project.data.cardTitle}
          description={project.data.cardDescription}
          cover={project.data.cover}
          tech={project.data.tech}
          href={`/pages/${project.id}.html`}
        />
      ))
    }
    {
      externalProjects.map((project) => (
        <ProjectCard
          title={project.cardTitle}
          description={project.cardDescription}
          cover={project.cover}
          tech={project.tech}
          href={project.href}
        />
      ))
    }
  </div>
</section>
