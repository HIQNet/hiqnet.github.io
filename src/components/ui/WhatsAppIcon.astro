---
import { whatsappPath } from "../../lib/utils/brand";

interface Props {
  size?: number | string;
  class?: string;
}

const { size = 16, class: className } = Astro.props;
---

<!-- Official WhatsApp glyph. Brand marks are not approximated with Lucide. -->
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="currentColor"
  width={size}
  height={size}
  class:list={["icon", className]}
  aria-hidden="true"
  focusable="false"
>
  <path d={whatsappPath}></path>
</svg>
