---
import TechBadge from "./TechBadge.astro";

interface Props {
  title: string;
  description: string;
  cover: string;
  tech: string[];
  href: string;
}

const { title, description, cover, tech, href } = Astro.props;
---

<a href={href}>
  <div class="portfolio-card bg-white dark:bg-slate-800 rounded-xl overflow-hidden shadow-lg transition-all duration-300 hover:shadow-xl cursor-pointer">
    <div class="h-48 overflow-hidden">
      <img
        src={cover}
        alt={title}
        class="w-full h-full object-cover transition-transform duration-500 hover:scale-110"
      />
    </div>
    <div class="p-6">
      <h3 class="text-xl font-bold mb-2">{title}</h3>
      <p class="text-slate-600 dark:text-slate-300 mb-4 text-justify">{description}</p>
      <div class="flex flex-wrap gap-2">
        {tech.map((name) => <TechBadge name={name} />)}
      </div>
    </div>
  </div>
</a>
