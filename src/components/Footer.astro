---
import { footerSectionLinks, site } from "../data/site";
import { services } from "../data/home";

const isHome =
    Astro.url.pathname === "/" || Astro.url.pathname.endsWith("/index.html");
const hrefFor = (hash: string) => (isHome ? hash : `/index.html${hash}`);
---

<footer class="bg-slate-900 text-white py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div
            class="grid grid-cols-1 md:grid-cols-4 gap-8 text-center md:text-left"
        >
            <div>
                <img
                    src="/img/FullLogo.webp"
                    alt={`${site.name} - Soluciones Tecnológicas`}
                    class="w-96 sm:w-md md:w-126 lg:w-160 xl:w-160 p-2 mx-auto md:mx-0"
                />
                <p class="text-slate-400">
                    Impulsando el futuro digital de las empresas con soluciones
                    tecnológicas innovadoras y de calidad.
                </p>
            </div>

            <div>
                <h4 class="text-lg font-semibold mb-4">Servicios</h4>
                <ul class="space-y-2">
                    {
                        services.map((service) => (
                            <li>
                                <a
                                    href={hrefFor("#services")}
                                    class="text-slate-400 hover:text-white transition-colors"
                                >
                                    {service.title}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <div>
                <h4 class="text-lg font-semibold mb-4">Enlaces</h4>
                <ul class="space-y-2">
                    {
                        footerSectionLinks.map((link) => (
                            <li>
                                <a
                                    href={hrefFor(link.hash)}
                                    class="text-slate-400 hover:text-white transition-colors"
                                >
                                    {link.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <div>
                <h4 class="text-lg font-semibold mb-4">Contacto</h4>
                <p
                    class="text-slate-400 mb-2 flex items-center gap-2 justify-center md:justify-start"
                >
                    <i class="fas fa-envelope"></i>
                    <a href={`mailto:${site.email}`}>{site.email}</a>
                </p>
                <p
                    class="text-slate-400 flex items-center gap-2 justify-center md:justify-start"
                >
                    <i class="fas fa-clock"></i>
                    {site.schedule}
                </p>
            </div>
        </div>

        <div
            class="border-t border-slate-800 mt-12 pt-8 flex flex-col md:flex-row justify-between items-center"
        >
            <p class="text-slate-500 text-sm mb-4 md:mb-0">
                © 2026 {site.name}. Todos los derechos reservados.
            </p>
            <div class="flex space-x-6">
                <a
                    href={site.socials.facebook}
                    class="text-slate-500 hover:text-white transition-colors"
                    aria-label="Facebook"><i class="fab fa-facebook-f"></i></a
                >
                <a
                    href={site.socials.instagram}
                    class="text-slate-500 hover:text-white transition-colors"
                    aria-label="Instagram"><i class="fab fa-instagram"></i></a
                >
            </div>
        </div>
    </div>
</footer>
