---
import { site } from "../data/site";
---

<footer class="site-footer">
    <div class="container-page">
        <div class="footer-main">
            <div class="footer-brand">
                <a class="brand-link" href="/" aria-label="HiQNet, inicio">
                    <img
                        src="/img/FullLogo.webp"
                        alt="HiQNet"
                        width="1850"
                        height="550"
                        loading="lazy"
                    />
                </a>
                <p>Software construido alrededor de cómo opera tu empresa.</p>
            </div>
            <nav class="footer-links" aria-label="Contacto y redes sociales">
                <a href={`mailto:${site.email}`} data-event="click_email">
                    {site.email}
                </a>
                <a
                    href={site.socials.instagram}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Instagram ↗
                </a>
                <a
                    href={site.socials.facebook}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Facebook ↗
                </a>
            </nav>
        </div>
        <div class="footer-bottom">
            <span>© {new Date().getFullYear()} HiQNet</span>
            <span>Entender. Conectar. Construir.</span>
            <a href="/#inicio">Volver al inicio ↑</a>
        </div>
    </div>
</footer>
