---
import { testimonials } from "../data/home";
---

<section class="py-20 bg-slate-50 dark:bg-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">
        Frases <span class="gradient-text">Célebres</span>
      </h2>
      <p class="text-lg text-slate-600 dark:text-slate-300 max-w-3xl mx-auto">
        Inspiración de los grandes pensadores de la tecnología que nos guían en
        nuestro trabajo diario.
      </p>
    </div>

    <div class="relative max-w-4xl mx-auto">
      <div class="testimonial-slider overflow-hidden">
        <div class="flex transition-transform duration-500" id="testimonial-track">
          {
            testimonials.map((testimonial) => (
              <div class="w-full flex-shrink-0 px-4 text-center">
                <div class="bg-white dark:bg-slate-700 p-8 rounded-xl shadow-lg">
                  <div class="text-2xl text-slate-700 dark:text-slate-200 italic mb-6">
                    "{testimonial.quote}"
                  </div>
                  <div class="flex justify-center items-center">
                    <div class="w-12 h-12 gradient-bg rounded-full flex items-center justify-center text-white font-bold mr-4">
                      {testimonial.initials}
                    </div>
                    <div>
                      <div class="font-bold">{testimonial.author}</div>
                      <div class="text-sm text-slate-500 dark:text-slate-400">{testimonial.role}</div>
                    </div>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Dots Navigation -->
      <div class="flex justify-center mt-8 gap-2" id="testimonial-dots">
        {
          testimonials.map((_, index) => (
            <button
              class:list={[
                "w-3 h-3 rounded-full dot",
                index === 0
                  ? "bg-purple-300 dark:bg-purple-700 active"
                  : "bg-purple-300 dark:bg-purple-700",
              ]}
              data-index={index}
              aria-label={`Ir a la frase ${index + 1}`}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>
